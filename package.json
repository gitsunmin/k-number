{
  "name": "@gitsunmin/k-number",
  "version": "1.0.0",
  "description": "숫자를 입력하면 한글 수사를 반환하는 기능을 제공하는 라이브러리입니다. (ex. 1234 -> 천이백삼십사)",
  "private": false,
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "author": "gitsunmin <tjsals116@gmail.com>",
  "files": [
    "dist/cjs/**/*.js",
    "dist/cjs/**/*.d.ts",
    "dist/esm/**/*.js",
    "dist/esm/**/*.d.ts",
    "!dist/**/*.test.*",
    "!dist/**/test/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json",
    "launch": "bun run build && npm publish --access public",
    "launch:dry-run": "npm publish --dry-run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "korean",
    "korean-number",
    "number-to-korean",
    "korean-numeral",
    "number",
    "formatting",
    "localization",
    "i18n",
    "한글",
    "한국어",
    "숫자",
    "수사",
    "변환",
    "숫자변환",
    "만",
    "억",
    "조"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitsunmin/k-number.git"
  },
  "bugs": {
    "url": "https://github.com/gitsunmin/k-number/issues"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.3",
    "husky": "^9.1.7",
    "tsc-alias": "^1.8.17",
    "typescript": "6.0.3",
    "vitest": "^3.2.3"
  }
}